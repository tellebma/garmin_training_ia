# Copy to .env and fill in real values. Never commit .env.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Note: SUPABASE_JWT_SECRET is no longer needed — user JWTs are now verified
# via JWKS (ES256/ECC P-256) fetched from <SUPABASE_URL>/auth/v1/.well-known/jwks.json

# Worker security
# Generate via: uv run python -c "from garmin_sync.crypto import generate_fernet_key; print(generate_fernet_key())"
FERNET_KEY=replace-with-44-char-base64-fernet-key=
# Optional: comma-separated key chain for zero-downtime key rotation. First
# key = active (used for all new encryption), the rest are legacy keys kept
# only to decrypt not-yet-rotated rows. Leave unset for normal operation —
# see deploy/SECRETS_ROTATION.md for the full rotation procedure.
# FERNET_KEYS=new-active-key=,old-legacy-key=
# Generate via: openssl rand -base64 32
WORKER_SHARED_TOKEN=replace-with-32-byte-base64-token

# Runtime
ENV=dev
# Sentry error tracking — leave SENTRY_DSN empty to disable (dev/test stay offline).
# Errors are always captured when a DSN is set; the sample rate only controls
# performance tracing (0.0 = off, 0.1 = 10% of transactions).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Discord alerting — push notification on every captured error. Leave empty to
# disable. Create via Discord: Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# OpenAI LLM
OPENAI_API_KEY=sk-your-api-key
# Organization admin key (different from OPENAI_API_KEY) — read-only access to the
# Costs API, used by billing_sync.py for ground-truth finops. Never exposed to the front.
OPENAI_ADMIN_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=30

# Strava OAuth (OPTIONAL, and PAUSED since 2026-07-26 — the API access this project
# needs requires a paid Strava plan the owner is not taking).
# Leave all three UNSET: the worker boots, Garmin sync runs normally, and the four
# /strava/* routes answer 404 so the unauthenticated webhook cannot be reached.
# Setting them re-enables the integration — read the E15.1 security notes in
# docs/superpowers/BACKLOG.md first (the webhook accepts forged deauth events).
# Register app at https://www.strava.com/settings/api to obtain client_id and client_secret.
# STRAVA_WEBHOOK_VERIFY_TOKEN is a random string you generate and set once when creating
# the webhook subscription — used for validating incoming webhook events.
# STRAVA_CLIENT_ID=replace-with-strava-client-id
# STRAVA_CLIENT_SECRET=replace-with-strava-client-secret
# STRAVA_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-string
