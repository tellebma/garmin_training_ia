# Supabase project URL (from https://supabase.com/dashboard/project/<id>/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Worker URL (Python Garmin sync worker)
# Local dev: http://localhost:8080
# Production: https://garmin-sync.tellebma.fr
WORKER_URL=http://localhost:8080

# Strava OAuth client ID (app registration at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=replace-with-strava-client-id
